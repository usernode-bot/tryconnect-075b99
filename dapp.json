{
  "description": "Temukan zona dan lokasi terbaik untuk mencari cuan",
  "icon": {
    "emoji": "📍"
  },
  "secrets": [],
  "permissions": [
    {
      "capability": "geolocation",
      "reason": "Mengurutkan zona dari yang paling dekat dan menandai zona baru"
    }
  ],
  "governance": {
    "preset": "you_or_the_group"
  },
  "tests": [
    {
      "name": "Zone list loads",
      "path": "/",
      "expectSelector": "[data-zone-list], .zone, .state-empty"
    },
    {
      "name": "Populated demo",
      "path": "/?demo=1",
      "expectText": "Pasar Pagi Kebon Jeruk",
      "visual": true,
      "impact": [
        "public/**",
        "server.js",
        "styles/**"
      ]
    },
    {
      "name": "Demo zone updates",
      "path": "/api/zones?demo=1",
      "expectText": "antrean penumpang panjang"
    },
    {
      "name": "Points line present",
      "path": "/?demo=1",
      "expectSelector": "[data-points]"
    },
    {
      "name": "Health",
      "path": "/health",
      "expectText": "ok"
    }
  ],
  "visibility": {
    "build": "public",
    "view": "public"
  }
}
